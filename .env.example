# ============================================================
# SISTEM PERENCANAAN MATERI ADAPTIF & PELAPORAN OTOMATIS
# Environment Configuration
# ============================================================

# --- DATABASE ---
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@localhost:5432/db_pendidikan

# --- JWT AUTH ---
SECRET_KEY=[PLACEHOLDER_SECRET_KEY_PANJANG_MIN_32_KARAKTER]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OLLAMA (Model Lokal) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_NAME=llama3

# --- LLM EKSTERNAL (opsional fallback) ---
EXTERNAL_LLM_API_URL=[PLACEHOLDER_URL_API_LLM_EKSTERNAL]
EXTERNAL_LLM_API_KEY=[PLACEHOLDER_API_KEY_LLM_EKSTERNAL]
EXTERNAL_LLM_MODEL=[PLACEHOLDER_NAMA_MODEL_EKSTERNAL]

# --- EMAIL (kirim laporan ke orang tua) ---
SMTP_HOST=[PLACEHOLDER_SMTP_HOST]
SMTP_PORT=587
SMTP_USERNAME=[PLACEHOLDER_EMAIL_PENGIRIM]
SMTP_PASSWORD=[PLACEHOLDER_PASSWORD_EMAIL]
EMAIL_FROM=[PLACEHOLDER_EMAIL_PENGIRIM]

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- UPLOAD ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads/

# --- APP ---
APP_ENV=development
DEBUG=True
