# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Salin file ini menjadi .env lalu isi nilainya sesuai environment kamu.
# JANGAN commit file .env ke Git — sudah ada di .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Untuk lokal (tanpa Docker):
DATABASE_URL=postgresql://postgres:password@localhost:5432/adaptive_db

# Untuk Docker Compose (nama service = postgres):
# DATABASE_URL=postgresql://postgres:password@postgres:5432/adaptive_db

# ── JWT / SECURITY ────────────────────────────────────────────────────────────
# Wajib diganti! Generate dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-ini-dengan-string-acak-minimal-64-karakter-yang-kuat
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── OLLAMA / AI ───────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── SMTP (kirim email laporan) ────────────────────────────────────────────────
# Untuk Gmail: buat App Password di myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=emailkamu@gmail.com
SMTP_PASSWORD=app-password-dari-gmail
SMTP_FROM=emailkamu@gmail.com

# ── APP ───────────────────────────────────────────────────────────────────────
APP_NAME=Sistem Perencanaan Materi Adaptif
DEBUG=false
